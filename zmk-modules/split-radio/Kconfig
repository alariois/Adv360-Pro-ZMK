config ZMK_SPLIT_RADIO
	bool "Split link over the raw nRF52840 radio instead of Bluetooth"
	depends on ZMK_SPLIT && !BT && SOC_NRF52840
	help
	  Both halves talk over the radio in Nordic's proprietary 2 Mbit mode
	  on one channel, AES-CCM encrypted with a pre-shared key: sub-ms
	  latency instead of Bluetooth's 3-20 ms. Needs CONFIG_BT=n (the radio
	  can't be shared with Zephyr's Bluetooth controller), so the keyboard
	  works over USB only (left half plugged in). The left half keeps its
	  receiver on (~5 mA from USB); the right half runs on its battery,
	  sends key events at once and polls the left half every POLL_MS for
	  the LED state.

if ZMK_SPLIT_RADIO

config ZMK_SPLIT_RADIO_KEY
	string "Pre-shared AES-128 key, 32 hex digits (generated by the Makefile)"

config ZMK_SPLIT_RADIO_FREQUENCY
	int "Channel: 2400 + this MHz (default between Wi-Fi channels 6 and 11)"
	default 50
	range 0 100

config ZMK_SPLIT_RADIO_TX_POWER
	int "TX power register value (0 = 0 dBm, 8 = +8 dBm, 0xFC = -4 dBm)"
	default 0

config ZMK_SPLIT_RADIO_ACK_DELAY_US
	int "Left half: ack this long after a frame (the right half must be listening)"
	default 200

config ZMK_SPLIT_RADIO_ACK_TIMEOUT_US
	int "How long the right half waits for an ack"
	default 800

config ZMK_SPLIT_RADIO_MAX_RETRIES
	int "Unacked resends before the right half handshakes again"
	default 10
	help
	  The left half may have restarted (new challenge). Retries after 20
	  back off up to 1 s while the left half doesn't answer.

config ZMK_SPLIT_RADIO_POLL_MS
	int "Right half: poll the left half this often without key events"
	default 100
	help
	  Brings the LED state (layer colors, caps lock, ...) to the right half
	  and shows that the link is up. Each poll costs ~1 ms of radio and
	  crystal time: ~50 uA at 100 ms.

config ZMK_SPLIT_RADIO_HF_HOLD_MS
	int "Right half: keep the crystal oscillator running this long after sending"
	default 1000
	help
	  Starting it takes ~0.4 ms (added to the first key after a pause);
	  running costs ~0.25 mA.

config ZMK_SPLIT_RADIO_STALE_MS
	int "Right half: drop key presses older than this when the link comes back"
	default 500

endif
