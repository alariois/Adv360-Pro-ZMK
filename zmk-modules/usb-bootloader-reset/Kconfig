config ZMK_USB_BOOTLOADER_RESET
	bool "Reboot into the UF2 bootloader on a USB CDC ACM baud-rate 'touch'"
	depends on USB_CDC_ACM
	select CDC_ACM_DTE_RATE_CALLBACK_SUPPORT
	help
	  Registers a DTE rate callback on every zephyr,cdc-acm-uart instance.
	  When the host sets the magic baud rate (1200 by default, the classic
	  Arduino/Adafruit "1200 baud touch"), the device writes the UF2
	  bootloader magic into GPREGRET and reboots, exactly like the
	  &bootloader behavior does.

if ZMK_USB_BOOTLOADER_RESET

config ZMK_USB_BOOTLOADER_RESET_BAUD
	int "Magic baud rate that triggers the reboot"
	default 1200

config ZMK_USB_BOOTLOADER_RESET_DELAY_MS
	int "Delay before rebooting, lets the USB control transfer finish"
	default 100

endif

config ZMK_WATCHDOG
	bool "Reset the half if its firmware hangs (hardware watchdog)"
	default y
	depends on WATCHDOG
	help
	  The nRF watchdog resets the chip unless the system work queue (where
	  ZMK handles keys) feeds it: a hung half restarts within
	  ZMK_WATCHDOG_TIMEOUT_MS and its USB serial port comes back, so the
	  1200 baud bootloader reset keeps working without the reset button.
	  The reset reason is kept for the key monitor ("reset=" in its hello).

config ZMK_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout"
	default 4000
	depends on ZMK_WATCHDOG
