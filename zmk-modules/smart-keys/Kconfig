config ZMK_MOD_MORPH_UNMASK_ON_NEXT_KEY
	bool "Stop mod-morph modifier masking when another key is pressed"
	depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
	help
	  A mod-morph that hides the modifier that triggered it (e.g. Shift for
	  a shift-proof '=') keeps hiding it for as long as its key is held, for
	  every key. When typing fast the next key is often pressed before the
	  mod-morph key is released, and comes out without Shift ('>l' instead
	  of '>L'). With this option the mask is cleared as soon as another key
	  is pressed; the mod-morph's own key press was already sent by then.

config ZMK_BEHAVIOR_SMART_REPEAT
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_SMART_REPEAT_ENABLED
	depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

if ZMK_BEHAVIOR_SMART_REPEAT

config ZMK_SMART_REPEAT_MAX_KEYS
	int "Most keycodes one repeat replays (macros, unicode entry)"
	default 32

config ZMK_SMART_REPEAT_STEP_MS
	int "Delay between replayed key presses/releases of a multi-key recording"
	default 5

config ZMK_SMART_REPEAT_SPLIT_WAIT_MS
	int "How long a repeat key on the central half waits for the other half"
	default 25
	help
	  Split keyboards: the peripheral's key presses reach the central a
	  few ms to ~20 ms late (Bluetooth). A repeat key on the central half
	  waits this long before repeating, so a key pressed just before it on
	  the other half is the one repeated. The central's own key events in
	  the meantime are held back and replayed after it. 0 disables.

endif

config ZMK_BEHAVIOR_ONESHOT_LAYER
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_ONESHOT_LAYER_ENABLED
	depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_BEHAVIOR_SMART_CAPS_WORD
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_SMART_CAPS_WORD_ENABLED
	depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
