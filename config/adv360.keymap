#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

// Caps word (tap both Shift keys) keeps going through ':' (MAC addresses via
// the Hexpad) and '-' (CONSTANT-NAMES). Letters and digits always continue;
// UNDERSCORE BACKSPACE DELETE are ZMK's defaults.
&caps_word {
    continue-list = <UNDERSCORE BACKSPACE DELETE COLON MINUS>;
};

/ {
  behaviors {
    #include "macros.dtsi"
    #include "user_macros.dtsi"
    #include "version.dtsi"

    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick_tap_ms = <175>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
    };

    comma_tilde: comma_tilde {
                compatible = "zmk,behavior-mod-morph";
                label = "comma_tilde";
                #binding-cells = <0>;
                bindings = <&kp COMMA>, <&kp TILDE>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    double_quotes_less_than: double_quotes_less_than {
                compatible = "zmk,behavior-mod-morph";
                label = "double_quotes_less_than";
                #binding-cells = <0>;
                bindings = <&macro_dqt>, <&kp LESS_THAN>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    sqt_greater_than: sqt_greater_than {
                compatible = "zmk,behavior-mod-morph";
                label = "sqt_greater_than";
                #binding-cells = <0>;
                bindings = <&macro_sqt>, <&kp GREATER_THAN>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    bslh_pipe: bslh_pipe {
                compatible = "zmk,behavior-mod-morph";
                label = "bslh_pipe";
                #binding-cells = <0>;
                bindings = <&kp BSLH>, <&kp PIPE>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    fslh_caret: fslh_caret {
                compatible = "zmk,behavior-mod-morph";
                label = "fslh_caret";
                #binding-cells = <0>;
                bindings = <&macro_fslh>, <&macro_caret>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    dollar_grave: dollar_grave {
                compatible = "zmk,behavior-mod-morph";
                label = "dollar_grave";
                #binding-cells = <0>;
                bindings = <&kp DOLLAR>, <&kp GRAVE>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    semi_hash: semi_hash {
                compatible = "zmk,behavior-mod-morph";
                label = "semi_hash";
                #binding-cells = <0>;
                bindings = <&kp SEMI>, <&kp HASH>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    colon_question: colon_question {
                compatible = "zmk,behavior-mod-morph";
                label = "colon_question";
                #binding-cells = <0>;
                bindings = <&kp COLON>, <&kp QUESTION>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    dot_ampersand: dot_ampersand {
                compatible = "zmk,behavior-mod-morph";
                label = "dot_ampersand";
                #binding-cells = <0>;
                bindings = <&kp DOT>, <&kp AMPERSAND>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    dot_ampersand_tap: dot_ampersand_tap {
                compatible = "zmk,behavior-mod-morph";
                label = "dot_ampersand_tap";
                #binding-cells = <0>;
                bindings = <&macro_dot>, <&macro_ampersand>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    hash_tilde: hash_tilde {
                compatible = "zmk,behavior-mod-morph";
                label = "hash_tilde";
                #binding-cells = <0>;
                bindings = <&kp HASH>, <&kp TILDE>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    // Hexpad key: tap = next key only (Shift doesn't use it up), tap again =
    // off, hold = momentary; releasing it after Ctrl+Shift+U unicode entry
    // sends the finishing Enter. zmk-modules/smart-keys.
    sl_hex: oneshot_layer_hex {
                compatible = "zmk,behavior-oneshot-layer";
                #binding-cells = <1>;
                release-after-ms = <1000>;
                display-name = "Hexpad";
        };
    // Repeat key: replays whatever the last key typed (whole macros, unicode
    // entry, exact modifiers), skips Space. zmk-modules/smart-keys.
    repeat: smart_repeat {
                compatible = "zmk,behavior-smart-repeat";
                #binding-cells = <0>;
                display-name = "Repeat";
        };
    percent_at: percent_at {
                compatible = "zmk,behavior-mod-morph";
                label = "percent_at";
                #binding-cells = <0>;
                bindings = <&kp PERCENT>, <&kp AT>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
       };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      // Right thumb, stock PgDn position: &sl_hex 5 temporarily replaces &macro_lalt_mo_1
      bindings = <
        &hash_tilde        &percent_at        &kp LEFT_BRACE           &kp LEFT_PARENTHESIS &macro_plus &repeat &to 1                                                                                              &mo 4         &repeat &kp ASTRK    &kp RIGHT_PARENTHESIS &kp RIGHT_BRACE &macro_equal &kp EXCL
        &kp TAB            &comma_tilde       &double_quotes_less_than &sqt_greater_than    &kp P       &kp Y       &macro_colon                                                                                       &macro_semi   &kp F       &kp G        &kp C                 &kp R           &kp L        &bslh_pipe
        &kp ESC            &kp A              &kp O                    &kp E                &kp U       &kp I       &macro_fslh            &macro_lctrl_mo_1 &macro_lgui_mo_1 &macro_lgui_mo_1 &macro_rctrl_mo_1       &macro_dollar &kp D       &kp H        &kp T                 &kp N           &kp S        &macro_minus
        &macro_lshift_mo_6 &dot_ampersand_tap &kp Q                    &kp J                &kp K       &kp X                                                &sl 3            &sl 3                                                  &kp B       &kp M        &kp W                 &kp V           &kp Z        &macro_rshift_mo_7
        &repeat        &kp LEFT           &kp RIGHT                &macro_dollar        &macro_semi                          &kp SPACE &kp ENTER         &macro_lalt_mo_1 &sl_hex 5           &kp BSPC          &sl_hex 5                          &macro_colon &macro_fslh           &kp DOWN        &kp UP       &repeat
      >;
    };

    layer_original {
      display-name = "QWERTY";
      // Plain modifiers on the thumbs: Base's macro_*_mo_1 keys would end
      // this layer when released (&mo 1 release) after &to 1 switched to it.
      bindings = <
        &kp EQUAL &kp N1   &kp N2    &kp N3    &kp N4   &kp N5 &to 0                                                         &mo 4  &kp N6 &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q    &kp W     &kp E     &kp R    &kp T  &none                                                         &mo 0  &kp Y  &kp U    &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A    &kp S     &kp D     &kp F    &kp G  &trans        &kp LCTRL &kp LGUI &kp LGUI &kp RCTRL           &trans &kp H  &kp J    &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z    &kp X     &kp C     &kp V    &kp B                          &mo 3    &mo 3                               &kp N  &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 3     &kp LEFT &kp RIGHT &kp GRAVE &kp CAPS               &trans &trans    &kp LALT &trans   &trans    &sl_hex 5               &kp LBKT &kp RBKT  &kp DOWN &kp UP   &mo 3
      >;
    };

    layer_keypad {
      display-name = "Keypad";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4    &kp N5 &trans                                                           &mo 4 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F     &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V     &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 3     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT               &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 3
      >;
    };

    layer_fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3   &kp F4   &kp F5  &kp F6  &tog 1                                           &mo 4 &kp F7    &kp F8    &kp F9         &kp F10         &kp F11       &kp F12
        &trans &trans &trans   &trans   &trans  &trans  &none                                            &none &kp PG_UP &trans    &trans         &trans          &macro_degree &trans
        &trans &trans &kp HOME &kp BSPC &kp DEL &kp END &none         &trans &trans &trans &trans        &none &trans    &kp PG_UP &kp SCROLLLOCK &kp PRINTSCREEN &trans        &trans
        &trans &trans &trans   &trans   &trans  &trans                       &trans &trans                     &trans    &trans    &trans         &trans          &trans        &trans
        &trans &trans &trans   &trans   &trans                 &trans &trans &trans &trans &trans &trans                 &trans    &trans         &trans          &trans        &trans
      >;
    };

    layer_mod {
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                                         &trans                 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                                                   &bootloader            &none        &none        &none        &none        &none        &none
        &studio_unlock &none        &none        &none        &none        &none        &rgb_ug RGB_MEFS_CMD 5                 &bt BT_CLR &none &bt BT_CLR &bt BT_CLR                 &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none        &none        &none
        &none          &none        &none        &none        &macro_ver   &none                                                          &none &none                                                        &none        &none        &none        &none        &none        &none
        &none          &none        &none        &bl BL_INC   &bl BL_DEC                                       &rgb_ug RGB_TOG &bl BL_TOG &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none        &none        &none
      >;
    };

    layer_hexpad {
      display-name = "Hexpad";
      bindings = <
        &macro_s_caron  &kp COMMA &trans &macro_pipe   &trans        &trans            &trans                                                   &trans &trans    &trans         &kp AMPERSAND &trans        &trans        &macro_z_caron
        &kp AT          &kp A     &kp B  &kp C         &kp D         &macro_underscore &trans                                                   &trans &kp GRAVE &unshifted_n2  &unshifted_n3 &unshifted_n4 &unshifted_n5 &macro_bslh
        &macro_ctrl_f11 &kp E     &kp F  &unshifted_n0 &unshifted_n1 &kp LBKT          &trans        &trans &trans         &trans &trans        &trans &kp RBKT  &unshifted_n6  &unshifted_n7 &unshifted_n8 &unshifted_n9 &kp PERCENT
        &kp LSHFT       &trans    &kp I  &trans        &trans        &trans                                 &macro_unicode &trans                      &kp COLON &macro_o_tilde &macro_a_dqt  &macro_o_dqt  &macro_u_dqt  &kp RSHFT
        &trans          &trans    &trans &kp PLUS      &kp MINUS                              &trans &trans &trans         &trans &trans &trans                  &kp ASTRK      &kp HASH      &trans        &trans        &trans
      >;
    };

    layer_left_shift {
      display-name = "LShift";
      bindings = <
        &trans     &trans &trans &trans           &trans      &trans &tog 1                                                    &mo 4            &trans &trans          &trans       &trans &unshifted_equal &trans
        &trans     &trans &trans &trans           &trans      &trans &macro_question                                           &macro_hash      &trans &trans          &trans       &trans &trans           &trans
        &trans     &trans &trans &trans           &trans      &trans &macro_caret           &trans &trans &trans &trans        &unshifted_grave &trans &trans          &trans       &trans &trans           &trans
        &caps_word &trans &trans &trans           &trans      &trans                               &trans &trans                                &trans &trans          &trans       &trans &trans           &caps_word
        &trans     &trans &trans &unshifted_grave &macro_hash                        &trans &trans &trans &trans &trans &trans                         &macro_question &macro_caret &trans &trans           &trans
      >;
    };

    layer_right_shift {
      display-name = "RShift";
      bindings = <
        &trans     &trans &trans &trans           &trans      &trans &tog 1                                                    &mo 4            &trans &trans          &trans       &trans &unshifted_equal &trans
        &trans     &trans &trans &trans           &trans      &trans &macro_question                                           &macro_hash      &trans &trans          &trans       &trans &trans           &trans
        &trans     &trans &trans &trans           &trans      &trans &macro_caret           &trans &trans &trans &trans        &unshifted_grave &trans &trans          &trans       &trans &trans           &trans
        &caps_word &trans &trans &trans           &trans      &trans                               &trans &trans                                &trans &trans          &trans       &trans &trans           &caps_word
        &trans     &trans &trans &unshifted_grave &macro_hash                        &trans &trans &trans &trans &trans &trans                         &macro_question &macro_caret &trans &trans           &trans
      >;
    };
  };
};
