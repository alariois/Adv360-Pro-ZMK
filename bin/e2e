#!/usr/bin/env python3
"""Run the end-to-end keyboard tests in tests/e2e against the real keyboard.

The keyboard must run the TEST firmware; --flash builds and flashes it
first (do that after changing the keymap). While the tests run, a capture
window takes the keyboard focus: don't type or click elsewhere.

Usage: bin/e2e [--flash] [-k PATTERN] [--skip PATTERN] [--left-only] [-v] [-x]
  -k PATTERN      only run tests whose name contains PATTERN (repeatable)
  --skip PATTERN  leave out tests whose name contains PATTERN (repeatable),
                  e.g. on a host whose compose table can't type some letters
  --left-only     inject the right half's keys on the left half too: tests
                  the keymap without the split link (noisy radio channel);
                  the split-timing tests are skipped
"""

import argparse
import fnmatch
import os
import subprocess
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def ensure_gtk_python():
    """The capture window uses GTK (PyGObject). Re-run with the system Python
    if the current one doesn't have it."""
    try:
        import gi  # noqa: F401
        return
    except ImportError:
        pass
    system = "/usr/bin/python3"
    if os.path.exists(system) and os.path.realpath(system) != os.path.realpath(sys.executable):
        if subprocess.run([system, "-c", "import gi"], capture_output=True).returncode == 0:
            os.execv(system, [system, __file__, *sys.argv[1:]])
    sys.exit("The e2e tests need PyGObject with GTK 3: sudo apt install python3-gi gir1.2-gtk-3.0")


def without(suite, globs):
    """`suite` minus the tests whose id (module.Class.test_name) matches a glob."""
    kept = unittest.TestSuite()
    for test in suite:
        if isinstance(test, unittest.TestSuite):
            kept.addTest(without(test, globs))
        elif not any(fnmatch.fnmatchcase(test.id(), g) for g in globs):
            kept.addTest(test)
    return kept


def main():
    ensure_gtk_python()
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--flash", action="store_true", help="build + flash the test firmware first")
    ap.add_argument("-k", action="append", dest="patterns", help="only tests matching PATTERN")
    ap.add_argument("--skip", action="append", default=[], metavar="PATTERN",
                    help="leave out tests matching PATTERN")
    ap.add_argument("--left-only", action="store_true",
                    help="inject all keys on the left half (no split link)")
    ap.add_argument("-v", action="store_true", help="verbose")
    ap.add_argument("-x", action="store_true", help="stop at the first failure")
    args = ap.parse_args()

    if args.flash:
        subprocess.run([ROOT / "bin/flash.sh", "--test"], check=True)
    if args.left_only:
        os.environ["ADV360_E2E_LEFT_ONLY"] = "1"

    from tests.e2e.harness import E2EError, Session

    loader = unittest.TestLoader()
    if args.patterns:
        loader.testNamePatterns = [f"*{p}*" for p in args.patterns]
    suite = loader.discover(str(ROOT / "tests/e2e"), top_level_dir=str(ROOT))
    if args.skip:
        suite = without(suite, [f"*{p}*" for p in args.skip])
    try:
        result = unittest.TextTestRunner(verbosity=2 if args.v else 1, failfast=args.x).run(suite)
    except E2EError as e:
        sys.exit(f"e2e setup failed: {e}")
    finally:
        Session.close()
    sys.exit(0 if result.wasSuccessful() else 1)


if __name__ == "__main__":
    main()
